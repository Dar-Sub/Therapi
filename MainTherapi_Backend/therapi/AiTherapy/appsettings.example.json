{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "server=localhost;port=3306;user=YOUR_USER;password=YOUR_PASSWORD;database=aitherapi;"
  },
  "AzureOpenAI": {
    "Endpoint": "https://YOUR-RESOURCE.openai.azure.com/",
    "Key": "YOUR_AZURE_OPENAI_KEY",
    "Model": "your-deployment-name",
    "AssistantId": "asst_YOUR_ASSISTANT_ID"
  },
  "DeepSeek": {
    "ApiUrl": "https://api.deepseek.com/chat/completions",
    "ApiKey": "YOUR_DEEPSEEK_API_KEY"
  },
  "JwtOptions": {
    "SecurityKey": "YOUR_LONG_RANDOM_SECRET_KEY_MIN_32_CHARS",
    "Issuer": "AiTherapi",
    "Audience": "AiTherapi"
  }
}
